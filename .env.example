# ============================================================
# Server Configuration
# ============================================================
# PORT=3000
# NODE_ENV=development

# Comma-separated list of allowed origins for CORS (e.g., https://yourdomain.com,https://app.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reverse Proxy Trust Configuration (number of hops, 'true', or specific subnets)
TRUST_PROXY=1

# ============================================================
# Authentication & Security
# ============================================================
# Mandatory: Generate a strong 64-character secret for signing JWT cookies (min 32 chars in production)
JWT_SECRET=generate_a_unique_secret_here_do_not_use_default
SESSION_TTL_HOURS=24

# ============================================================
# Database Configuration (Supabase PostgreSQL Connection URI)
# ============================================================
# Direct connection string format with least-privilege DB user:
# DATABASE_URL=postgresql://web_auth_user:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Or connection pooler (port 6543):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Enforce strict CA verification for DB TLS connection (defaults to true in production)
DB_SSL_REJECT_UNAUTHORIZED=true

# ============================================================
# In-Memory Rate Limiting Configuration (with TTL)
# ============================================================
# Window duration in milliseconds (default: 15 minutes = 900000 ms)
RATE_LIMIT_WINDOW_MS=900000

# Maximum allowed failed login attempts per device + IP fingerprint within the window
RATE_LIMIT_MAX_ATTEMPTS=5

# Maximum allowed global burst attempts per IP within the window (defense against device ID rotation)
IP_BURST_MAX_ATTEMPTS=15

